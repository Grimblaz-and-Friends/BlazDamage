#!/bin/sh
# Pre-commit hook: strip trailing whitespace from staged files.
# Configured via: git config core.hooksPath .githooks

# Get list of staged files (added, copied, modified — not deleted)
staged=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged" ]; then
    exit 0
fi

for file in $staged; do
    # Only process files that exist
    if [ -f "$file" ]; then
        mode=$(git ls-files -s -- "$file" | cut -d' ' -f1)
        hash=$(git show :"$file" | sed 's/[[:space:]]*$//' | git hash-object -w --stdin) || exit 1
        git update-index --cacheinfo "${mode},${hash},${file}"
    fi
done

exit 0
